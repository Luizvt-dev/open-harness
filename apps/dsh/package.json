{
  "name": "@open-harness/dsh-cli",
  "version": "0.1.0",
  "description": "CLI `dsh` — arranque por perfis do Open Harness (kernel cordis + composição declarativa)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "dsh": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "bundles"],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@open-harness/app-boot": "workspace:*",
    "@open-harness/cordis": "workspace:*",
    "@open-harness/dsh-agent": "workspace:*",
    "@open-harness/dsh-agent-loop": "workspace:*",
    "@open-harness/dsh-api-gateway": "workspace:*",
    "@open-harness/dsh-api-remotes": "workspace:*",
    "@open-harness/dsh-client-connection": "workspace:*",
    "@open-harness/dsh-client-modules": "workspace:*",
    "@open-harness/dsh-llm": "workspace:*",
    "@open-harness/dsh-provider": "workspace:*",
    "@open-harness/dsh-session": "workspace:*",
    "@open-harness/dsh-tool-bash": "workspace:*",
    "@open-harness/dsh-tool-fs": "workspace:*",
    "@open-harness/dsh-tool-fs-search": "workspace:*",
    "@open-harness/dsh-tools": "workspace:*",
    "@open-harness/dsh-host-webserver": "workspace:*",
    "@open-harness/home-paths": "workspace:*",
    "@open-harness/profile-boot": "workspace:*",
    "yaml": "^2.8.1"
  }
}
